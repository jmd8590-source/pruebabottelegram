{
  "name": "telegram-bot-negocio",
  "version": "1.0.0",
  "description": "Bot de Telegram 24/7 para pequeñas y medianas empresas",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "nodemon src/bot.js",
    "pm2:start": "pm2 start src/bot.js --name telegram-bot --restart-delay 3000",
    "pm2:stop": "pm2 stop telegram-bot",
    "pm2:restart": "pm2 restart telegram-bot",
    "pm2:logs": "pm2 logs telegram-bot",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-telegram-bot-api": "^0.66.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
